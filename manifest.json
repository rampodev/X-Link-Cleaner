{
  "manifest_version": 3,
  "name": "X Link Cleaner",
  "version": "1.0.2",
  "description": "Strips tracking parameters from copied X/Twitter links and rewrites them to fixupx.com.",
  "minimum_chrome_version": "126",
  "content_scripts": [
    {
      "matches": ["*://*.x.com/*", "*://*.twitter.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "x-link-cleaner@rampo.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
